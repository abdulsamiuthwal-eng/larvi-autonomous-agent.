{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/(chat|chat/stream|sessions|sessions/.*|auth/.*|health|emails/.*|calendar/.*|settings/.*|docs|openapi\\.json)",
      "dest": "backend/main.py"
    },
    {
      "src": "/",
      "dest": "frontend/splash.html"
    },
    {
      "src": "/splash",
      "dest": "frontend/splash.html"
    },
    {
      "src": "/login",
      "dest": "frontend/login.html"
    },
    {
      "src": "/app",
      "dest": "frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
