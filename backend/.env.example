# ═══════════════════════════════════════════════════════════════════════════════
# LARVI — Autonomous Email & Calendar AI Agent
# Environment Configuration Template (backend/.env.example)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Google Gemini API Configuration ──────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash-lite,gemini-3.7-flash,gemini-3.6-flash

# ── Google Cloud OAuth 2.0 (Gmail & Google Calendar) ─────────────────────────
# 1. Create a Google Cloud Project at: https://console.cloud.google.com/
# 2. Enable "Gmail API" and "Google Calendar API"
# 3. Create OAuth 2.0 Client IDs (Web Application)
# 4. Set Authorized Redirect URI: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── Server Configuration ──────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True
FRONTEND_URL=http://localhost:5500

# ── User Preferences & Guardrails ────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Karachi
WORKING_HOURS_START=09:00
WORKING_HOURS_END=18:00
REQUIRE_CONFIRMATION_FOR_SEND=True
REQUIRE_CONFIRMATION_FOR_DELETE=True
