# ╔══════════════════════════════════════════════════════════════════╗
# ║            LARVI — Environment Variables Template                ║
# ║   Copy this file to .env and fill in your actual values         ║
# ║   NEVER commit .env or credentials.json to version control      ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── 1. Google Gemini AI ────────────────────────────────────────────
# Get your free API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# ─── 2. Google OAuth 2.0 Credentials ───────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# App type: Web Application
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Paths to credential files (relative to backend/)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# ─── 3. Application Settings ────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_random_secret_key_here
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ─── 4. CORS — Frontend URL ─────────────────────────────────────────
# Local dev: http://localhost:5500
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5500
